# Обязательные настройки бота
TELEGRAM_BOT_TOKEN=
DISABLE_TELEGRAM_BOT=0
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-sonnet-4-6
CLAUDE_METADATA_MODEL=claude-haiku-4-5-20251001
CLAUDE_DUPLICATE_MODEL=claude-sonnet-4-6
CLAUDE_QR_SCREENING_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_OUTPUT_TOKENS=350
CLAUDE_PROMPT_CACHE_ENABLED=1
CLAUDE_PROMPT_CACHE_TTL=1h
AI_MAX_SAVINGS_MODE=1

# База и доступ администратора
BOT_DB_PATH=medical_bot.db
EXCEL_REPORTS_DIR=excel_files
ADMIN_TELEGRAM_IDS=
CREATOR_TELEGRAM_ID=
CREATOR_DJANGO_USERNAME=

# Проверка изображений через Sightengine (необязательно)
SIGHTENGINE_ENABLED=1
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_AI_THRESHOLD=0.75

# Настройки фоновой обработки фотографий
BACKGROUND_PHOTO_WORKERS=1
BOT_WORK_START_HOUR=7
BOT_WORK_END_HOUR=19
MAX_METADATA_VERIFICATION=0
AI_ADAPTIVE_METADATA_RETRY=1
AI_METADATA_CONFIDENCE_THRESHOLD=0.78
AI_DUPLICATE_BATCH_SIZE=3
AI_DUPLICATE_MAX_CANDIDATES=3
AI_METADATA_CANDIDATE_LIMIT=3
AI_DUPLICATE_MIN_CONFIDENCE=0.94
AI_BROAD_DUPLICATE_CHECKS_ENABLED=1
IMAGE_PROCESSING_MAX_DIMENSION=1280
AI_READING_MAX_DIMENSION=1920
QR_SCAN_MAX_DIMENSION=4096
QR_SCAN_TARGET_DIMENSION=2400
# Старые фотографии не пересканируются автоматически: это сохраняет скорость сайта.
# Включайте временно только для обслуживания в часы низкой нагрузки.
QR_BACKFILL_ENABLED=0
QR_BACKFILL_BATCH_SIZE=2
# Полная возобновляемая перепроверка всех исторических фото без номера QR.
# По умолчанию выключена: включайте временно, чтобы не расходовать баланс и CPU сайта.
FULL_QR_RECHECK_ENABLED=0
FULL_QR_RECHECK_VERSION=2
FULL_QR_RECHECK_BATCH_SIZE=1
FULL_QR_RECHECK_DELAY_SECONDS=8
FULL_QR_RECHECK_MAX_FAILURES=3
# Старая перепроверка только 27–28 сентября заменена полным проходом выше.
TARGETED_NO_QR_RECHECK_ENABLED=0
TARGETED_NO_QR_RECHECK_DATE_FROM=2026-09-27
TARGETED_NO_QR_RECHECK_DATE_TO=2026-09-28
TARGETED_NO_QR_RECHECK_VERSION=1
TARGETED_NO_QR_RECHECK_DELAY_SECONDS=3
TARGETED_NO_QR_DUPLICATE_FALLBACK=2
AI_PHASH_MAX_DISTANCE=10
CROP_HASH_HAMMING_CUTOFF=6
# Локальные отпечатки помогают находить обрезки, повороты и заменённый фон.
# Архивная индексация по умолчанию отключена: на одном процессе Render она
# конкурирует с сайтом и Telegram-ботом за CPU и SQLite. Включайте её только
# временно во время технических работ.
VISUAL_HASH_MAX_DISTANCE=12
DUPLICATE_VISUAL_BACKFILL_ENABLED=0
DUPLICATE_VISUAL_BACKFILL_DELAY_SECONDS=15
URGENCH_DUPLICATE_AUDIT_ENABLED=1
URGENCH_DUPLICATE_AUDIT_VERSION=1
URGENCH_DUPLICATE_AUDIT_DELAY_SECONDS=2
URGENCH_DUPLICATE_AUDIT_LOOKBACK=20000
GLOBAL_DUPLICATE_AUDIT_ENABLED=1
GLOBAL_DUPLICATE_AUDIT_VERSION=1
GLOBAL_DUPLICATE_AUDIT_DELAY_SECONDS=3
GLOBAL_DUPLICATE_AUDIT_LOOKBACK=20000
GLOBAL_DUPLICATE_AUDIT_USE_AI=0
PACKAGE_DATE_MIN_YEAR=2020
PACKAGE_DATE_MAX_YEAR=2035

# Настройки сайта Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DB_PATH=django_portal/portal.sqlite3
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
